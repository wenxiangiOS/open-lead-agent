# ============================================================
# open-lead-agent environment example
# open-lead-agent 环境变量示例
#
# Copy this file to `.env` before local development:
# 本地开发前，先复制一份为 `.env`：
#
#   cp .env.example .env
#
# Do not commit your real `.env` if it contains API keys.
# 如果 `.env` 里写了真实 API Key，不要提交到代码仓库。
# ============================================================

# ------------------------------------------------------------
# App metadata / 应用基础信息
# ------------------------------------------------------------

# Application name shown in logs or deployment metadata.
# 应用名称，主要用于日志或部署环境识别。
APP_NAME=open-lead-agent

# Runtime environment. Common values: development, staging, production.
# 运行环境。常见值：development、staging、production。
APP_ENV=development

# Debug switch for local development. Keep false in production.
# 调试开关。生产环境建议保持 false。
APP_DEBUG=false

# ------------------------------------------------------------
# Template selection / 行业模板选择
# ------------------------------------------------------------

# Active business template. Examples: matchmaking, education, education-simple.
# 当前启用的业务模板。例如：matchmaking、education、education-simple。
ACTIVE_TEMPLATE=matchmaking

# Directory that contains all templates. Relative paths are resolved from project root.
# 模板所在目录。相对路径会从项目根目录解析。
TEMPLATES_DIR=./templates

# ------------------------------------------------------------
# LLM provider / 大模型配置
# ------------------------------------------------------------

# Provider name. Currently the built-in client uses OpenAI-compatible chat APIs.
# 模型供应商名称。当前内置客户端使用 OpenAI-compatible 聊天接口。
LLM_PROVIDER=openai_compatible

# API key for your model provider. Leave empty to use local fallback replies.
# 模型 API Key。留空时会使用本地 fallback 回复，方便先跑通项目。
LLM_API_KEY=

# Model name deployed by your provider.
# 模型名称，填写供应商侧可用的模型 ID。
LLM_MODEL=doubao-seed-2-0-pro-260215

# OpenAI-compatible base URL.
# OpenAI-compatible 接口地址。
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Sampling temperature. Lower is more stable; higher is more creative.
# 采样温度。越低越稳定，越高越发散。
LLM_TEMPERATURE=0.7

# Maximum tokens generated per response.
# 单次回复最多生成的 token 数。
LLM_MAX_TOKENS=800

# Request timeout in seconds.
# 单次模型请求超时时间，单位秒。
LLM_TIMEOUT_SECONDS=30

# Max automatic retries for one model call. Keep 0 in local debugging so failures return fast.
# 单次模型调用的自动重试次数。本地调试建议 0，避免一次超时被 SDK 重试拖到很久。
LLM_MAX_RETRIES=0

# ------------------------------------------------------------
# Storage / 状态存储
# ------------------------------------------------------------

# Conversation state storage provider. Currently memory is the built-in default.
# 对话状态存储。当前内置默认是 memory，后续可扩展 Redis/Postgres。
STORAGE_PROVIDER=memory
