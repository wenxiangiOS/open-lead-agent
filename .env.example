# Doubao MCP Server Configuration
# 复制此文件为 .env 并填入实际值

# API 配置
ARK_API_KEY=your_doubao_api_key_here
BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型配置
MODEL_NAME=doubao-seed-1-6-251015

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/doubao_service.log

# 调试配置
DEBUG=False
RELOAD=False