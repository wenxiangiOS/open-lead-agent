# Doubao MCP Server Configuration
# 复制此文件为 .env 并填入实际值

# ==================== 环境配置 ====================
ENV=development
# 可选值: development, staging, production

# ==================== AI 服务配置 ====================
ARK_API_KEY=key
MODEL_NAME=模型
BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# AI 超时配置（秒）
AI_TIMEOUT=30
AI_MAX_RETRIES=3
AI_RETRY_DELAY=1.0

# AI 模型参数
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_TOP_P=0.9

# 火山引擎配置（可选）
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=

# ==================== 服务器配置 ====================
HOST=0.0.0.0
PORT=8000
WORKERS=1
TIMEOUT=120
KEEPALIVE=5

# 开发模式自动重载
 
# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S

# 文件日志
LOG_FILE_ENABLED=False
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# JSON 结构化日志
LOG_JSON_ENABLED=True

# 性能日志
LOG_PERFORMANCE=True
LOG_SLOW_QUERY_THRESHOLD=1.0

# ==================== 调试配置 ====================
DEBUG=False

# ==================== 安全配置 ====================
# JWT 认证
JWT_ENABLED=False
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=86400

# API 密钥
API_KEY_HEADER=X-API-Key
ALLOWED_API_KEYS=

# 加密配置
ENCRYPTION_KEY=

# 限流配置
IP_RATE_LIMIT=1000
USER_RATE_LIMIT=100

# 安全头
SECURITY_HEADERS_ENABLED=True
STRICT_TRANSPORT_SECURITY=True

# ==================== CORS 配置 ====================
# 生产环境设置允许的域名，用逗号分隔
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_METHODS=GET,POST,PUT,DELETE
CORS_HEADERS=Content-Type,Authorization,X-User-ID

# ==================== Redis 配置（高并发优化）====================
# 启用Redis以支持多实例部署和高并发
# 本地开发：使用 Docker Redis（运行 ./start-redis.sh 启动）
# 阿里云生产：使用阿里云 Redis 实例
REDIS_ENABLED=True

# 本地开发配置（Docker Redis）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 阿里云生产配置（部署时修改以下值）
# REDIS_HOST=r-xxxxx.redis.rds.aliyuncs.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# TTL 配置支持多种格式：
# - 秒数：86400（24小时）
# - 分钟：30m（30分钟）
# - 小时：24h（24小时）
# - 天：7d（7天）、1d（1天）
# - 周：1w（1周）
# - 月：1M（1月）
# - 年：1y（1年）
REDIS_TTL=24h
REDIS_MAX_CONNECTIONS=50

# Redis 健康检查
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_RECONNECT_ATTEMPTS=3

# ==================== 连接池配置 ====================
# HTTP 连接池大小（httpx 库的最大连接数）
# - 作用：控制同时能有多少个 HTTP 连接到 AI API
# - 建议：根据并发需求调整（50-500）
# - 影响：太小会导致请求等待可用连接
#   - 50 并发：建议 100
#   - 100 并发：建议 200
#   - 200 并发：建议 400
HTTP_CONNECTIONS=100

# HTTP Keep-Alive 最大连接数（保持活动状态的连接）
# - 作用：复用已建立的 HTTP 连接，减少握手开销
# - 建议：连接池大小的 10-20%
# - 影响：太小会频繁建立新连接，影响性能
#   - 连接池 100：建议 10-20
#   - 连接池 200：建议 20-40
HTTP_MAX_KEEPALIVE=20

# ==================== 并发配置（高并发优化）====================
# 【连接池配置】影响系统同时能保持多少个连接
#
# Redis 连接池：用于缓存存储的连接数
# - 作用：每个并发请求需要 1-2 个 Redis 连接
# - 建议：并发数 × 2，例如 100 并发 → 200 连接池
# - 影响：连接池太小会导致请求等待空闲连接
# - 调整：低并发(50): 50, 中并发(100): 100, 高并发(200): 200
CONCURRENCY_REDIS_POOL_SIZE=100
#
# HTTP 连接池：用于调用 AI API 的连接数
# - 作用：复用 HTTP 连接，避免频繁建立/断开连接
# - 建议：并发数 × 2，例如 100 并发 → 200 连接池
# - 影响：连接池太小会导致 AI API 调用缓慢
# - 调整：低并发(50): 50, 中并发(100): 100, 高并发(200): 200
CONCURRENCY_HTTP_POOL_SIZE=100
#
# HTTP Keep-Alive 连接数：保持活动状态的连接数
# - 作用：减少建立新连接的开销
# - 建议：连接池大小的 10-20%
# - 影响：太小会频繁建立新连接，影响性能
CONCURRENCY_HTTP_MAX_KEEPALIVE=20
#
# 【并发控制配置】核心配置，决定系统能同时处理多少请求
#
# 最大并发请求数：系统同时处理的请求数量上限（核心配置！）
# - 作用：超过此数量的请求会被放入队列等待或直接拒绝
# - 当前值 100：表示可以同时处理 100 个用户的请求
# - 建议：根据服务器性能和 AI API 限制调整
#   - 低配服务器：50-100（支持 10-50 用户）
#   - 中配服务器：100-200（支持 50-100 用户）
#   - 高配服务器：200-500（支持 100-200 用户）
# - 影响：直接影响系统的并发处理能力
CONCURRENCY_MAX_CONCURRENT_REQUESTS=100
#
# 请求队列大小：等待处理的请求队列长度
# - 作用：当并发达到上限时，新请求会在队列中等待
# - 建议：并发数的 2-3 倍
# - 影响：队列满后新请求会被拒绝（返回 429）
CONCURRENCY_REQUEST_QUEUE_SIZE=200
#
# 请求超时时间：单个请求的最大处理时间（秒）
# - 作用：超过此时间的请求会被中断
# - 建议：30-60 秒（AI 响应慢时需要更长）
# - 影响：太短会导致正常请求被中断
CONCURRENCY_REQUEST_TIMEOUT=30
#
# 【限流配置】防止某个用户/IP 发送过多请求
#
# 是否启用限流：true 启用，false 禁用
# - 作用：防止恶意用户或程序攻击
# - 建议：生产环境必须开启
CONCURRENCY_RATE_LIMIT_ENABLED=true
#
# 用户限流：每个用户每分钟最多请求数
# - 作用：防止单个用户发送过多请求
# - 当前值 200：每个用户每分钟最多 200 个请求
# - 建议：正常用户 50-200，VIP 用户 500-1000
# - 影响：超过限制会返回 429（请求过多）
CONCURRENCY_USER_RATE_LIMIT=200
#
# 全局限流：整个系统每分钟最多请求数
# - 作用：防止系统过载
# - 当前值 5000：系统每分钟最多处理 5000 个请求
# - 建议：根据服务器性能调整（5000-10000）
# - 影响：超过限制会影响所有用户
CONCURRENCY_GLOBAL_RATE_LIMIT=5000
#
# IP 限流：每个 IP 每分钟最多请求数
# - 作用：防止单个 IP 发送过多请求（防攻击）
# - 当前值 500：每个 IP 每分钟最多 500 个请求
# - 建议：200-1000
# - 影响：超过限制该 IP 会被暂时封禁
CONCURRENCY_IP_RATE_LIMIT=500

# ==================== 消息队列编排（小红书接入） ====================
# 开关
MQ_ENABLED=true

# 入站聚合与执行
MQ_DEBOUNCE_MS=300
MQ_DEBOUNCE_APPEND_MS=200
MQ_DEBOUNCE_MAX_MS=1200
# 是否启用关键词触发的 force_flush（生产建议 false）
MQ_FORCE_FLUSH_ENABLED=false
# sender 发送前静默窗口（毫秒），用于 latest-wins 临界防抖
MQ_PRE_SEND_SILENCE_MS=400
MQ_FIELD_ASK_COOLDOWN_TURNS=2
MQ_SKIP_GUARD_ENABLED=true
MQ_RUNNING_RECHECK_MS=300
MQ_MAX_PENDING_MESSAGES=20
MQ_MAX_COMBINED_CHARS=4000

# worker 调度
MQ_READY_BATCH_SIZE=100
MQ_WORKER_POLL_MS=20
MQ_WORKER_USER_CONCURRENCY=4
MQ_RUNNING_STALE_AFTER_MS=120000
MQ_RECOVERY_BATCH_SIZE=200
MQ_RECOVERY_INTERVAL_MS=5000
MQ_LOCK_TTL_SECONDS=180

# sender 调度
MQ_OUTBOX_BATCH_SIZE=100
MQ_OUTBOX_MAX_RETRIES=8
MQ_SENDER_POLL_MS=100
MQ_SENDER_JOB_CONCURRENCY=8

# TTL 配置支持多种格式（与 REDIS_TTL 一致）：
# - 秒数：86400（24小时）
# - 分钟：30m（30分钟）
# - 小时：24h（24小时）
# - 天：7d（7天）、1d（1天）
# - 周：1w（1周）
# - 月：1M（1月）
# - 年：1y（1年）
MQ_SESSION_TTL_SECONDS=7d
MQ_DEDUPE_TTL_SECONDS=24h

# P1: 熔断/调度/分类
MQ_FAIL_STREAK_THRESHOLD=3
MQ_FAIL_STREAK_COOLDOWN_MS=5000
MQ_SCHEDULE_JITTER_MS=0

# P2: 优先级/自适应/热点隔离/上下文压缩
MQ_PRIORITY_BOOST_MS=200
MQ_ADAPTIVE_DEBOUNCE_ENABLED=false
MQ_HOT_USER_PENDING_THRESHOLD=8
MQ_HOT_USER_QUOTA_PER_LOOP=2
MQ_HOT_USER_RESCHEDULE_MS=100
MQ_CONTEXT_COMPACTION_ENABLED=false

# 小红书发送通道
XHS_REPLY_API=
XHS_REPLY_API_BACKUP=
XHS_REPLY_TIMEOUT_SECONDS=8
XHS_REPLY_MAX_CONNECTIONS=100
XHS_REPLY_MAX_KEEPALIVE=20

# 在线聊天链路快失败策略（降低长尾）
AI_CHAT_MAX_RETRIES=1
AI_CHAT_RETRY_DELAY_SECONDS=0.5

# 在线聊天 AI 调用超时主配置
# 说明：
# - CHAT_AI_TIMEOUT_SECONDS 是主配置
# - 如果下面 3 个覆盖项没有显式填写，系统会自动推导：
#   AI_HTTP_TOTAL_TIMEOUT_SECONDS = CHAT_AI_TIMEOUT_SECONDS + 5
#   CHAT_AI_HARD_TIMEOUT_SECONDS = CHAT_AI_TIMEOUT_SECONDS + 10
#   CONCURRENCY_REQUEST_TIMEOUT = CHAT_AI_TIMEOUT_SECONDS + 20
# - 如果下面覆盖项显式填写了，就以显式值为准，不再自动推导该项
CHAT_AI_TIMEOUT_SECONDS=45

# 可选覆盖项 1：底层 HTTP 客户端总超时
# - 这一层作用在 AsyncOpenAI/httpx 客户端本身
# - 它控制“单次 HTTP 请求最多等多久”
# - 如果这里比 CHAT_AI_TIMEOUT_SECONDS 更小，会先在网络层抛 ReadTimeout / APITimeoutError
# - 只有你想显式放大或收紧 HTTP 层等待时间时才需要单独填写
# - 不填时自动推导为 CHAT_AI_TIMEOUT_SECONDS + 5
AI_HTTP_TOTAL_TIMEOUT_SECONDS=

# 可选覆盖项 2：AI 调用硬超时兜底
# - 这一层包住业务侧 AI 调用协程
# - 用于防止模型调用、重试链路或后处理整体卡住
# - 不填时自动推导为 CHAT_AI_TIMEOUT_SECONDS + 10
CHAT_AI_HARD_TIMEOUT_SECONDS=50

# 可选覆盖项 3：整条请求处理链路的总超时
# - 这一层是整个接口请求的总上限
# - 包含上下文加载、规则判断、AI 调用、提取、状态保存等完整流程
# - 不填时自动推导为 CHAT_AI_TIMEOUT_SECONDS + 20
CONCURRENCY_REQUEST_TIMEOUT=60

# AI 原始响应调试日志
# - 默认关闭，避免日志过重
# - 打开后会记录原始响应长度、usage、finish_reason，以及响应预览
AI_RAW_RESPONSE_LOG_ENABLED=true
# 原始响应预览长度（字符）
AI_RAW_RESPONSE_PREVIEW_CHARS=4000

# AI 话术统一生成主链开关
# - true: 启用“AI draft -> validation -> safe cleanup -> delivery freeze”
# - false: 回滚到 legacy finalize 改写链
AI_RAW_RESPONSE_MODE=true
# 紧急熔断开关（优先级高于 AI_RAW_RESPONSE_MODE）
AI_RAW_RESPONSE_KILL_SWITCH=false

# 可选：模型路由（低风险低复杂度轮次走快模型）
AI_ROUTING_ENABLED=true
AI_FAST_MODEL_NAME=
