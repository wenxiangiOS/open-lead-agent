{
  "scenarios": [
    {
      "id": "mq_ingest_basic_ack",
      "category": "mq",
      "tags": ["mq", "pending", "critical"],
      "description": "ingest 基础入队应返回 accepted=true（需通过 ingest API E2E 实现断言）",
      "messages": ["你好"],
      "ingest_payloads": [
        {
          "accountId": "mq_reg_basic_ack",
          "dialogId": "mq_basic_ack",
          "message": "你好",
          "platformMsgId": "mq_basic_ack_1"
        }
      ],
      "mq_expect": {
        "expected_statuses": ["queued"],
        "expected_accepted": [true]
      },
      "assertions": []
    },
    {
      "id": "mq_ingest_duplicate_platform_msg_id",
      "category": "mq",
      "tags": ["mq", "pending", "dedupe", "critical"],
      "description": "重复 platform_msg_id 只处理一次（需 ingest E2E 断言）",
      "messages": ["重复消息测试"],
      "ingest_payloads": [
        {
          "accountId": "mq_reg_duplicate",
          "dialogId": "mq_duplicate",
          "message": "重复消息测试",
          "platformMsgId": "mq_duplicate_1"
        },
        {
          "accountId": "mq_reg_duplicate",
          "dialogId": "mq_duplicate",
          "message": "重复消息测试",
          "platformMsgId": "mq_duplicate_1"
        }
      ],
      "mq_expect": {
        "expected_statuses": ["queued", "duplicate"],
        "expected_accepted": [true, false]
      },
      "assertions": []
    },
