          "accountId": "{{ACCOUNT_ID}}_a",
          "dialogId": "mq_hot_user_a_{{RUN_ID}}",
          "message": "hot user fairness a1",
          "platformMsgId": "mq_hot_user_a1_{{RUN_ID}}"
        },
        {
          "accountId": "{{ACCOUNT_ID}}_a",
          "dialogId": "mq_hot_user_a_{{RUN_ID}}",
          "message": "hot user fairness a2",
          "platformMsgId": "mq_hot_user_a2_{{RUN_ID}}"
        },
        {
          "accountId": "{{ACCOUNT_ID}}_b",
          "dialogId": "mq_hot_user_b_{{RUN_ID}}",
          "message": "hot user fairness b1",
          "platformMsgId": "mq_hot_user_b1_{{RUN_ID}}"
        },
        {
          "accountId": "{{ACCOUNT_ID}}_a",
          "dialogId": "mq_hot_user_a_{{RUN_ID}}",
          "message": "hot user fairness a3",
          "platformMsgId": "mq_hot_user_a3_{{RUN_ID}}"
        },
        {
          "accountId": "{{ACCOUNT_ID}}_b",
          "dialogId": "mq_hot_user_b_{{RUN_ID}}",
          "message": "hot user fairness b2",
          "platformMsgId": "mq_hot_user_b2_{{RUN_ID}}"
        },
        {
          "accountId": "{{ACCOUNT_ID}}_b",
          "dialogId": "mq_hot_user_b_{{RUN_ID}}",
          "message": "hot user fairness b3",
          "platformMsgId": "mq_hot_user_b3_{{RUN_ID}}"
        }
      ],
      "mq_expect": {
        "expected_statuses": ["queued", "queued", "queued", "queued", "queued", "queued"],
        "expected_accepted": [true, true, true, true, true, true]
