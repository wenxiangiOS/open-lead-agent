    {
      "id": "field_conflict_location_change_once",
      "category": "field_collection",
      "tags": ["stability", "conflict", "location"],
      "description": "用户从深圳改口到广州，最终应保留最后一次明确地点。",
      "messages": [
        "我在深圳",
        "更正一下，我现在在广州"
      ],
      "assertions": [
        { "type": "profile_field_truthy", "field": "location" }
      ]
    },
    {
      "id": "field_conflict_age_change_once",
      "category": "field_collection",
      "tags": ["stability", "conflict", "age"],
      "description": "用户年龄从28改口到29，最终应以最后说法为准。",
      "messages": [
        "我28岁",
        "补充下，我29岁"
      ],
      "assertions": [
        { "type": "profile_field_truthy", "field": "age" }
      ]
    },
    {
      "id": "field_conflict_education_change_once",
      "category": "field_collection",
      "tags": ["stability", "conflict", "education"],
      "description": "用户学历从本科改口到硕士，最终应以最新信息为准。",
      "messages": [
        "我是本科",
        "更正下，我是硕士"
      ],
      "assertions": [
        { "type": "profile_field_truthy", "field": "education" }
      ]
    },
