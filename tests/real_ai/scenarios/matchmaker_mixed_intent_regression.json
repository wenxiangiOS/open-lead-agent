{
  "scenarios": [
    {
      "id": "matchmaker_mixed_answer_fee",
      "category": "matchmaker_mixed_intent",
      "tags": ["critical", "humanlike", "mixed", "faq"],
      "description": "用户同句给性别并问收费，应同时接住资料和收费。",
      "messages": ["男的，怎么收费"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["男生", "收费", "免费", "定制"] }
      ]
    },
    {
      "id": "matchmaker_mixed_location_store",
      "category": "matchmaker_mixed_intent",
      "tags": ["humanlike", "mixed", "faq"],
      "description": "用户同句给地点并问门店，应同时接住所在地语境和门店信息。",
      "messages": ["我在深圳，门店在哪"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["深圳", "门店", "线下", "定位"] }
      ]
    },
    {
      "id": "matchmaker_mixed_contact_fee",
      "category": "matchmaker_mixed_intent",
      "tags": ["critical", "humanlike", "mixed", "faq", "contact"],
      "description": "用户说电话不方便但能留微信同时问收费，应优先接住微信和收费。",
      "messages": ["电话不方便，我可以留微信，你们收费吗"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["微信", "收费", "免费", "定制"] },
        { "type": "final_response_not_contains_any", "values": ["必须留电话", "先留电话"] }
      ]
    },
    {
      "id": "matchmaker_mixed_education_boundary",
      "category": "matchmaker_mixed_intent",
      "tags": ["humanlike", "mixed", "boundary"],
      "description": "用户同句给出学历并表达不方便，应接住两层意思。",
      "messages": ["本科，不过这个先不太方便说"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["本科", "不太想展开", "不方便", "先不追问"] }
      ]
    },
    {
      "id": "matchmaker_mixed_preference_reliability",
      "category": "matchmaker_mixed_intent",
      "tags": ["critical", "humanlike", "mixed", "reliability"],
      "description": "用户同时给偏好并问靠不靠谱，应接住偏好或担心，但不能只硬答其中一半。",
      "messages": ["喜欢深圳女生，你们靠谱吗"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["深圳", "女生", "靠谱", "安全", "放心"] }
      ]
    },
    {
      "id": "matchmaker_mixed_topic_shift_fee",
      "category": "matchmaker_mixed_intent",
      "tags": ["critical", "humanlike", "mixed", "topic_shift", "faq"],
      "description": "用户明确先说收费时，应先顺着收费话题，不得切回资料采集。",
      "messages": ["先不聊资料，先说收费"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["先顺着", "收费", "免费", "定制"] },
        { "type": "final_response_not_contains_any", "values": ["你在哪个城市", "你多大", "你学历"] }
      ]
    },
    {
      "id": "matchmaker_mixed_topic_shift_store",
      "category": "matchmaker_mixed_intent",
      "tags": ["humanlike", "mixed", "topic_shift", "faq"],
      "description": "用户要求先聊门店时，应先顺着门店话题。",
      "messages": ["先聊这个，门店在哪"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["先顺着", "门店", "线下", "定位"] }
      ]
    },
    {
      "id": "matchmaker_mixed_clarification_after_flow_word",
      "category": "matchmaker_mixed_intent",
      "tags": ["humanlike", "mixed", "clarification"],
      "description": "用户说什么意思时，应先接住没听明白，再解释，不要立刻问资料。",
      "messages": ["什么意思"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["直白", "换个说法", "没听明白"] },
        { "type": "final_response_not_contains_any", "values": ["你在哪个城市", "你多大"] }
      ]
    }
  ]
}
