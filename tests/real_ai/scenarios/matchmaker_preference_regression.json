{
  "scenarios": [
    {
      "id": "matchmaker_preference_city_first",
      "category": "matchmaker_preference",
      "tags": ["critical", "humanlike", "preference"],
      "description": "用户直接说喜欢深圳女生，应先承接深圳/女生偏好。",
      "messages": ["喜欢深圳女生"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["深圳", "女生", "偏向", "同城"] }
      ]
    },
    {
      "id": "matchmaker_preference_trait_first",
      "category": "matchmaker_preference",
      "tags": ["humanlike", "preference"],
      "description": "用户说想找成熟稳重，应先接住偏好再推进。",
      "messages": ["我想找成熟稳重一点的"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["成熟稳重", "偏好", "看重"] }
      ]
    },
    {
      "id": "matchmaker_preference_height_age_mix",
      "category": "matchmaker_preference",
      "tags": ["humanlike", "preference"],
      "description": "用户说高一点瘦一点年龄别太大，应先承接至少一个偏好点。",
      "messages": ["高一点瘦一点，年龄别太大"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["高", "瘦", "年龄", "偏好"] }
      ]
    },
    {
      "id": "matchmaker_preference_same_city_priority",
      "category": "matchmaker_preference",
      "tags": ["humanlike", "preference", "same_city"],
      "description": "用户说同城优先，应先接住同城，不切别的话题。",
      "messages": ["同城优先"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["同城", "本地", "偏好"] }
      ]
    },
    {
      "id": "matchmaker_preference_feeling_type",
      "category": "matchmaker_preference",
      "tags": ["humanlike", "preference", "soft"],
      "description": "用户说看感觉时，应把它当偏好接住，而不是机械追问。",
      "messages": ["看感觉吧"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["感觉", "随缘", "慢慢看", "偏好"] }
      ]
    },
    {
      "id": "matchmaker_preference_no_requirement",
      "category": "matchmaker_preference",
      "tags": ["humanlike", "preference", "soft"],
      "description": "用户说都可以/没啥要求时，应接住宽松偏好，不要把对话问僵。",
      "messages": ["都可以，没啥要求"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["都可以", "慢慢看", "宽松", "看感觉"] }
      ]
    }
  ]
}
