{
  "scenarios": [
    {
      "id": "matchmaker_consulting_service_intro_first",
      "category": "matchmaker_consulting",
      "tags": ["critical", "humanlike", "consulting"],
      "description": "用户先问你们是做什么的，应先顺着服务咨询回答，不切资料。",
      "messages": ["你们是做什么的"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["红娘", "牵线", "匹配", "同城脱单联盟"] },
        { "type": "final_response_not_contains_any", "values": ["你今年多大", "你在哪个城市", "留个电话"] }
      ]
    },
    {
      "id": "matchmaker_consulting_fee_first",
      "category": "matchmaker_consulting",
      "tags": ["critical", "humanlike", "consulting", "fee"],
      "description": "用户先问收费，应先接收费问题，再回答免费/定制。",
      "messages": ["怎么收费"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["收费", "免费", "定制"] },
        { "type": "final_response_not_contains_any", "values": ["先说下年龄", "先告诉我学历", "留个电话"] }
      ]
    },
    {
      "id": "matchmaker_consulting_store_first",
      "category": "matchmaker_consulting",
      "tags": ["humanlike", "consulting", "store"],
      "description": "用户先问门店，应先答门店信息，不切回资料。",
      "messages": ["有线下门店吗"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["门店", "线下", "深圳", "定位"] },
        { "type": "final_response_not_contains_any", "values": ["你在哪个城市", "你多大", "你做什么工作"] }
      ]
    },
    {
      "id": "matchmaker_consulting_how_match_first",
      "category": "matchmaker_consulting",
      "tags": ["humanlike", "consulting", "process"],
      "description": "用户先问怎么匹配，应先按流程答疑。",
      "messages": ["你们怎么匹配"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["匹配", "筛选", "线上", "线下"] },
        { "type": "final_response_not_contains_any", "values": ["先留电话", "先说学历", "先说年龄"] }
      ]
    },
    {
      "id": "matchmaker_consulting_timeline_first",
      "category": "matchmaker_consulting",
      "tags": ["humanlike", "consulting", "timeline"],
      "description": "用户问多久能安排，应先答节奏和周期。",
      "messages": ["多久能安排"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["周期", "节奏", "匹配", "时间"] }
      ]
    },
    {
      "id": "matchmaker_consulting_success_rate_first",
      "category": "matchmaker_consulting",
      "tags": ["humanlike", "consulting", "success_rate"],
      "description": "用户问成功率时，应先接住效果关心，再回答。",
      "messages": ["成功率高吗"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["成功", "案例", "匹配", "效果"] }
      ]
    },
    {
      "id": "matchmaker_consulting_photo_first",
      "category": "matchmaker_consulting",
      "tags": ["humanlike", "consulting", "photo"],
      "description": "用户问照片什么时候能看时，应先解释隐私和互换条件。",
      "messages": ["什么时候能看照片"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["照片", "合适", "隐私", "互换"] }
      ]
    },
    {
      "id": "matchmaker_consulting_contact_exchange_first",
      "category": "matchmaker_consulting",
      "tags": ["humanlike", "consulting", "contact_exchange"],
      "description": "用户问能不能先加对方时，应先答流程，不直接采集资料。",
      "messages": ["能先加对方微信吗"],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["双方", "合适", "联系方式", "安排"] },
        { "type": "final_response_not_contains_any", "values": ["你先留个电话", "先告诉我年龄"] }
      ]
    }
  ]
}
