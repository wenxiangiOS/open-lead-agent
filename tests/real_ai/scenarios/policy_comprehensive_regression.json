    {
      "id": "policy_separation_end",
      "category": "policy_ending",
      "tags": ["critical", "ending", "separation"],
      "description": "用户处于分居状态时，应直接结束服务流程。",
      "messages": [
        "我现在还在分居中"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true }
      ]
    },
    {
      "id": "policy_divorce_confirmed_continue",
      "category": "policy_ending",
      "tags": ["critical", "ending", "divorce"],
      "description": "离异但手续已办妥时，不应结束，应该继续收集。",
