{
  "scenarios": [
    {
      "id": "policy_core_field_priority_over_quasi",
      "category": "policy_priority",
      "tags": ["critical", "field_priority", "smoke"],
      "description": "核心字段优先：未收完核心字段前，不应让准核心和中等字段抢主线。",
      "messages": [
        "找对象"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 1, "values": ["婚况", "离异", "月薪", "收入", "择偶要求"] }
      ]
    },
    {
      "id": "policy_core_field_priority_sequence",
      "category": "policy_priority",
      "tags": ["critical", "field_priority"],
      "description": "核心字段优先顺序：性别/年龄/工作地 → 学历/职业。",
      "messages": [
        "找对象",
        "女",
        "28岁"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "sex", "expected": "女" },
        { "type": "profile_field_truthy", "field": "age" },
        { "type": "response_contains_any", "turn": 3, "values": ["城市", "在哪", "工作地", "学历", "职业"] }
      ]
    },
    {
      "id": "policy_quasi_core_marital_status_once_only",
      "category": "policy_ask_limit",
      "tags": ["critical", "marital_status", "ask_limit"],
      "description": "婚况最多1次主动问，一次未拿到即转被动提取。",
      "messages": [
        "我是女生，90后，深圳，本科，运营，想找男生",
        "不方便说婚况",
        "还是不方便说"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 3, "values": ["婚况", "结婚", "离异", "单身"] }
      ]
    },
    {
      "id": "policy_core_field_twice_max",
      "category": "policy_ask_limit",
      "tags": ["critical", "ask_limit", "core_field"],
      "description": "核心字段最多2次主动问，第3次不能追问。",
      "messages": [
        "找对象",
        "不想说年龄",
        "还是不想说",
        "真的不想说"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 4, "values": ["年龄", "多大了", "今年"] }
      ]
    },
    {
      "id": "policy_medium_field_once_max",
      "category": "policy_ask_limit",
      "tags": ["critical", "ask_limit", "medium_field"],
      "description": "中等字段（月薪）最多1次主动问，第2次不能追问。",
      "messages": [
        "我是女生，90后，深圳，本科，运营，单身",
        "收入不方便说",
        "还是不方便"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 3, "values": ["收入", "月薪", "工资", "待遇"] }
      ]
    },
    {
      "id": "policy_low_priority_never_ask_height",
      "category": "policy_ask_limit",
      "tags": ["critical", "low_priority", "never_ask"],
      "description": "低优字段（身高）永不主动问。",
      "messages": [
        "找对象"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 1, "values": ["身高", "多高", "cm"] }
      ]
    },
    {
      "id": "policy_low_priority_never_ask_name",
      "category": "policy_ask_limit",
      "tags": ["critical", "low_priority", "never_ask"],
      "description": "低优字段（姓名）永不主动问。",
      "messages": [
        "找对象"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 1, "values": ["叫什么名字", "怎么称呼", "你姓什么"] }
      ]
    },
    {
      "id": "policy_low_priority_never_ask_weight",
      "category": "policy_ask_limit",
      "tags": ["critical", "low_priority", "never_ask"],
      "description": "低优字段（体重）永不主动问。",
      "messages": [
        "找对象"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 1, "values": ["体重", "多少斤", "多重"] }
      ]
    },
    {
      "id": "policy_multi_field_extract_single_sentence",
      "category": "policy_extraction",
      "tags": ["critical", "multi_extract"],
      "description": "一句话多个字段，一次性全部提取。",
      "messages": [
        "我是女生，90后，在深圳，本科，做运营，单身"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "sex", "expected": "女" },
        { "type": "profile_field_truthy", "field": "age" },
        { "type": "profile_field_equals", "field": "location", "expected": "深圳" },
        { "type": "profile_field_equals", "field": "education", "expected": "本科" },
        { "type": "profile_field_truthy", "field": "occupation" }
      ]
    },
    {
      "id": "policy_contact_trigger_insufficient_fields",
      "category": "policy_contact",
      "tags": ["critical", "contact_trigger"],
      "description": "联系方式触发条件：只拿到1-2个基础字段时，不进入联系方式逻辑。",
      "messages": [
        "我是女生"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 1, "values": ["电话", "微信", "联系方式"] }
      ]
    },
    {
      "id": "policy_contact_trigger_sufficient_fields",
      "category": "policy_contact",
      "tags": ["critical", "contact_trigger"],
      "description": "联系方式触发条件：拿到4个及以上核心/准核心字段后，可进入联系方式逻辑。",
      "messages": [
        "我是女生，90后，深圳，本科，运营，单身，想找男生"
      ],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["电话", "微信", "联系"] }
      ]
    },
    {
      "id": "policy_contact_trigger_age_location_occupation",
      "category": "policy_contact",
      "tags": ["critical", "contact_trigger"],
      "description": "联系方式触发条件：已拿到年龄+工作地+职业/学历之一+婚况后，可进入联系方式。",
      "messages": [
        "我是女生，28岁，深圳，运营，单身"
      ],
      "assertions": [
        { "type": "profile_field_truthy", "field": "age" },
        { "type": "profile_field_truthy", "field": "location" },
        { "type": "profile_field_truthy", "field": "occupation" }
      ]
    },
    {
      "id": "policy_faq_answer_then_resume",
      "category": "policy_faq",
      "tags": ["critical", "faq_resume"],
      "description": "回答疑问后回主线：用户疑问 > 字段收集。",
      "messages": [
        "找对象",
        "怎么收费",
        "好的，我是女生，90后，深圳"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["免费", "收费", "定制"] },
        { "type": "profile_field_equals", "field": "sex", "expected": "女" }
      ]
    },
    {
      "id": "policy_reception_before_ask",
      "category": "policy_humanlike",
      "tags": ["critical", "reception", "humanlike"],
      "description": "承接规则：每次提问前，优先做承接，不要直接硬问。",
      "messages": [
        "我是女生，28岁"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 1, "values": ["28", "女生", "好", "收到", "了解", "记下"] }
      ]
    },
    {
      "id": "policy_transition_between_fields",
      "category": "policy_humanlike",
      "tags": ["critical", "transition", "humanlike"],
      "description": "转场规则：从一个字段切到另一个字段时，必须经过转场。",
      "messages": [
        "我是女生，28岁",
        "在深圳"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 2, "values": ["你学历是什么你职业是什么"] }
      ]
    },
    {
      "id": "policy_first_turn_greeting_ack",
      "category": "policy_first_turn",
      "tags": ["critical", "first_turn", "greeting"],
      "description": "首轮体验：用户第一句是纯问候时，必须先做自然承接，不得直接抛字段问题。",
      "messages": [
        "你好"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 1, "values": ["年龄多少", "学历", "职业", "电话"] }
      ]
    },
    {
      "id": "policy_first_turn_hi_ack",
      "category": "policy_first_turn",
      "tags": ["critical", "first_turn", "greeting"],
      "description": "首轮体验：用户说hi时，必须先做自然承接。",
      "messages": [
        "hi"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 1, "values": ["请告诉我年龄", "请告诉我学历"] }
      ]
    },
    {
      "id": "policy_first_turn_greeting_with_sex",
      "category": "policy_first_turn",
      "tags": ["critical", "first_turn"],
      "description": "首轮体验：即使已有sex资料，首轮纯问候也要承接。",
      "messages": [
        "在吗"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 1, "values": ["在", "好", "你好", "嗯"] }
      ]
    },
    {
      "id": "policy_cooldown_no_consecutive_same_field",
      "category": "policy_cooldown",
      "tags": ["critical", "cooldown"],
      "description": "连续追问限制：同一字段不能连续两轮都问。",
      "messages": [
        "找对象",
        "嗯"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 2, "values": ["年龄年龄", "多大了你多大了"] }
      ]
    },
    {
      "id": "policy_income_soft_ask",
      "category": "policy_income",
      "tags": ["critical", "income", "soft_ask"],
      "description": "月薪降压问法：必须带不方便说也没关系的语气。",
