    {
      "id": "policy_divorce_incomplete_end",
      "category": "policy_ending",
      "tags": ["critical", "ending", "divorce"],
      "description": "离异手续未办妥时，应结束当前服务流程。",
      "messages": [
        "我离异，手续还在办"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true }
      ]
