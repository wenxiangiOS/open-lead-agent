{
  "scenarios": [
    {
      "id": "ending_divorce_incomplete_should_end",
      "category": "ending",
      "tags": ["smoke", "critical", "divorce"],
      "description": "用户表示离异手续未办妥时，应结束当前服务流程。",
      "messages": [
        "我离异，手续还在办"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "final_response_contains_any", "values": ["办妥", "再来", "顺利"] }
      ]
    },
    {
      "id": "ending_separation_should_end",
      "category": "ending",
      "tags": ["critical", "ending_gate", "divorce"],
      "description": "用户处于分居状态时，应直接结束服务流程。",
      "messages": [
        "我现在还在分居中"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "final_response_contains_any", "values": ["分居", "办妥", "再来"] }
      ]
    },
    {
      "id": "ending_both_contact_refused",
      "category": "ending",
      "tags": ["critical", "ending_gate", "contact_phone", "contact_wechat"],
      "description": "当电话和微信都被拒绝后，应进入收尾状态。",
      "messages": [
        "我是女生，90后，深圳，本科，运营，单身，想找男生",
        "不留电话",
        "还是不留电话",
        "微信也不留",
        "还是不留微信"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "profile_field_equals", "field": "rejected_phone", "expected": true },
        { "type": "profile_field_equals", "field": "rejected_wechat", "expected": true }
      ]
    },
    {
      "id": "ending_age_under_limit",
      "category": "ending",
      "tags": ["critical", "ending_gate"],
      "description": "用户年龄低于 24 岁时，应结束当前服务流程。",
      "messages": [
        "我22岁，想找对象"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "profile_field_equals", "field": "age_under_limit", "expected": true },
        { "type": "final_response_contains_any", "values": ["24岁", "再来", "成熟"] }
      ]
    },
    {
      "id": "ending_already_married",
      "category": "ending",
      "tags": ["ending_gate"],
      "description": "用户明确已婚时，应结束当前服务流程。",
      "messages": [
        "我已经结婚了"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "final_response_contains_any", "values": ["单身", "家庭幸福", "帮不到"] }
      ]
    },
    {
      "id": "ending_proxy_user",
      "category": "ending",
      "tags": ["ending_gate"],
      "description": "代相亲用户应被识别并建议本人来聊。",
      "messages": [
        "我是帮朋友问的"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "proxy_user", "expected": true },
        { "type": "final_response_contains_any", "values": ["朋友", "家人", "本人直接来聊"] }
      ]
    },
    {
      "id": "ending_lgbt_user",
      "category": "ending",
      "tags": ["ending_gate"],
      "description": "LGBT 用户场景应触发预设收尾。",
      "messages": [
        "我是les，喜欢女生"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "final_response_contains_any", "values": ["异性相亲", "不太适合", "专业的平台"] }
      ]
    },
    {
      "id": "ending_divorce_confirmed_should_continue",
      "category": "ending",
      "tags": ["critical", "divorce"],
      "description": "用户离异但手续已办妥时，不应结束，应该继续收集。",
      "messages": [
        "我离异",
        "已经办妥了"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": false },
        { "type": "profile_field_truthy", "field": "marital_status" },
        { "type": "response_not_contains_any", "turn": 2, "values": ["再来", "暂时不能", "不符合"] }
      ]
    },
    {
      "id": "ending_after_conversation_ended_followup",
      "category": "ending",
      "tags": ["critical", "ending_gate"],
      "description": "对话已结束后用户再次发消息，应只给简短告别，不再继续收集。",
      "messages": [
        "我现在还在分居中",
        "你好，还在吗"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "response_contains_any", "turn": 2, "values": ["先这样", "再来找我", "拜拜", "下次再聊"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["年龄", "学历", "电话", "微信"] }
      ]
    },
    {
      "id": "ending_spam_user",
      "category": "ending",
      "tags": ["critical", "spam_user"],
      "description": "用户发广告词或垃圾信息时，应静默处理。",
      "messages": [
        "加微信", "发广告", "兼职", "赚钱", "月入", "日赚", "优惠", "折扣", "特价", "促销", "刷单", "刷好评", "刷评论"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "spam_user", "expected": true },
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true }
      ]
    },
    {
      "id": "ending_spam_user_variant",
      "category": "ending",
      "tags": ["spam_user"],
      "description": "用户用贷款借钱等敏感词时，应静默处理。",
      "messages": [
        "贷款", "借钱", "放贷", "网贷"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "spam_user", "expected": true },
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true }
      ]
    },
    {
      "id": "ending_spam_user_aggressive",
      "category": "ending",
      "tags": ["spam_user"],
      "description": "用户重复发送广告信息时，应静默处理。",
      "messages": [
        "推广", "广告", "合作", "商务合作", "代理", "兼职", "赚钱"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "spam_user", "expected": true },
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true }
      ]
    },
    {
      "id": "ending_normal_complete",
      "category": "ending",
      "tags": ["critical", "normal_complete"],
      "description": "所有信息收集完成，正常收尾流程。",
      "messages": [
        "我是女生，90后，在深圳，本科，运营，单身，想找男生", "我的电话是17688654321，微信是wx123456"
      ],
      "assertions": [
        { "type": "profile_field_truthy", "field": "phone" },
        { "type": "profile_field_truthy", "field": "wechat" },
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true }
      ]
    },
    {
      "id": "ending_fake_info_pattern",
      "category": "ending",
      "tags": ["ending_gate", "fake_info"],
      "description": "用户提供明显虚假信息时，应识别并收尾。",
      "messages": [
        "我是女生，今年1000岁，身高3米"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "final_response_contains_any", "values": ["有意思", "认真对待", "真实信息"] }
      ]
    },
    {
      "id": "ending_gay_user_variant",
      "category": "ending",
      "tags": ["ending_gate", "lgbt"],
      "description": "男同性恋用户应触发收尾。",
      "messages": [
        "我是gay，喜欢男生"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "final_response_contains_any", "values": ["异性相亲", "不太适合", "专业"] }
      ]
    },
    {
      "id": "ending_divorce_incomplete_variant",
      "category": "ending",
      "tags": ["divorce"],
      "description": "用户说离婚手续没办完时，应结束服务。",
      "messages": [
        "我离婚了，手续没办完"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "conversation_ended", "expected": true },
        { "type": "final_response_contains_any", "values": ["办妥", "再来", "手续"] }
      ]
    },
    {
      "id": "ending_proxy_user_variant",
      "category": "ending",
      "tags": ["ending_gate", "proxy_user"],
      "description": "用户帮亲戚问时应识别为代相亲。",
      "messages": [
        "我是帮亲戚问的"
      ],
      "assertions": [
        { "type": "profile_field_equals", "field": "proxy_user", "expected": true },
        { "type": "final_response_contains_any", "values": ["本人", "直接来", "让TA"] }
      ]
    }
  ]
}
