{
  "scenarios": [
    {
      "id": "faq_priority_mediator",
      "category": "faq",
      "tags": ["smoke", "critical", "faq_priority"],
      "description": "用户问“你是中介吗”时，应先答疑，不要在同一轮继续索要联系方式。",
      "messages": [
        "我是女生，90后，深圳，本科，运营，单身，想找男生",
        "你是中介吗"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["中介", "情况", "沟通", "继续"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信", "联系方式"] }
      ]
    },
    {
      "id": "faq_priority_fee",
      "category": "faq",
      "tags": ["critical", "faq_priority"],
      "description": "用户问收费时，先回答收费问题，不应同轮切回资料收集。",
      "messages": [
        "找对象",
        "怎么收费"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["免费", "收费", "定制"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信", "学历", "年龄"] }
      ]
    },
    {
      "id": "faq_priority_fee_paraphrase",
      "category": "faq",
      "tags": ["critical", "faq_priority", "paraphrase"],
      "description": "用户换说法问费用时（你们费用是怎么收的），仍应先答疑，不应同轮切回资料收集。",
      "messages": [
        "找对象",
        "你们费用是怎么收的"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["免费", "收费", "定制", "费用"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信", "学历", "年龄", "想找男生还是女生"] }
      ]
    },
    {
      "id": "faq_priority_contact_why_phone",
      "category": "faq",
      "tags": ["critical", "faq_priority", "contact_why"],
      "description": "用户问为什么要留电话时，本轮应先解释用途，不应继续索要联系方式。",
      "messages": [
        "我是男生，90后，深圳，本科，IT，单身，想找女生",
        "为什么要留电话呢"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["联系", "用途", "沟通", "确认", "方便"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["第一时间联系", "有合适的人选", "发资料", "1到8小时"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["留个电话号码", "方便留个电话", "留微信"] }
      ]
    },
    {
      "id": "faq_priority_store_location",
      "category": "faq",
      "tags": ["faq_priority"],
      "description": "用户问线下门店时，应先解释门店信息。",
      "messages": [
        "找对象",
        "有线下门店吗"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["深圳", "门店", "线下", "沟通安排"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["发具体定位", "发具体地址", "马上发定位"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信"] }
      ]
    },
    {
      "id": "faq_priority_how_match",
      "category": "faq",
      "tags": ["critical", "faq_priority"],
      "description": "用户问怎么匹配时，应先说明线上了解和后续牵线流程。",
      "messages": [
        "找对象",
        "你们怎么匹配"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["线上", "匹配", "沟通", "了解情况"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["线下安排", "安排见面", "发资料", "1到8小时"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信", "年龄"] }
      ]
    },
    {
      "id": "faq_priority_can_add_wechat",
      "category": "faq",
      "tags": ["critical", "faq_priority"],
      "description": "用户问能不能直接加对方微信时，应先说明由牵线同事安排互换。",
      "messages": [
        "找对象",
        "可以直接加对方微信吗"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["直接", "不会", "沟通", "确认"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["互换联系方式", "直接对接", "加对方微信", "发资料"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["你的微信", "留个微信", "电话"] }
      ]
    },
    {
      "id": "faq_priority_photo_request",
      "category": "faq",
      "tags": ["faq_priority"],
      "description": "用户要对方照片时，应说明双方合适后再互换。",
      "messages": [
        "找对象",
        "能先看照片吗"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["照片", "隐私", "不会现在就发", "沟通情况"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["互换照片", "发照片", "先把照片发你"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信"] }
      ]
    },
    {
      "id": "faq_priority_specific_target_respects_bidirectional_choice",
      "category": "faq",
      "tags": ["faq_priority", "preference", "humanlike"],
      "description": "用户只想要某个特定对象时，应先承接，但不能承诺一定能成。",
      "messages": [
        "找对象",
        "我就想要这个男生"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["这个男生", "双方", "不合适", "继续"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["100%", "保证", "一定成"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信"] }
      ]
    },
    {
      "id": "faq_priority_marriage_pace_respected",
      "category": "faq",
      "tags": ["faq_priority", "preference", "humanlike"],
      "description": "用户说暂时不想结婚、着急结婚的不要时，应先承接节奏偏好。",
      "messages": [
        "找对象",
        "我暂时不想结婚，着急结婚的不要"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["节奏", "慢慢", "相处", "了解"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信", "联系方式"] }
      ]
    },
    {
      "id": "faq_priority_followup_question_should_still_answer",
      "category": "faq",
      "tags": ["faq_priority"],
      "description": "用户连续追问收费细节时，第二轮仍应继续答疑而不是切回资料收集。",
      "messages": [
        "找对象",
        "怎么收费",
        "那定制服务怎么收费"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["免费", "收费", "定制"] },
        { "type": "response_contains_any", "turn": 3, "values": ["定制", "收费", "服务"] },
        { "type": "response_not_contains_any", "turn": 3, "values": ["电话", "微信", "学历"] }
      ]
    },
    {
      "id": "faq_priority_success_rate",
      "category": "faq",
      "tags": ["faq_priority"],
      "description": "用户问成功率时，应先解释服务效果。",
      "messages": [
        "找对象",
        "你们成功率怎么样"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["成功", "配对", "牵线", "案例"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信", "年龄"] }
      ]
    },
    {
      "id": "faq_priority_service_area",
      "category": "faq",
      "tags": ["faq_priority"],
      "description": "用户问服务范围时，应先说明覆盖地区。",
      "messages": [
        "找对象",
        "你们服务哪些地区"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["深圳", "地区", "范围"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信"] }
      ]
    },
    {
      "id": "faq_priority_time_required",
      "category": "faq",
      "tags": ["faq_priority"],
      "description": "用户问多久能找到时，应解释匹配周期。",
      "messages": [
        "找对象",
        "多久能找到对象"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["时间", "周期", "匹配", "因人而异"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["1到8小时", "1到2天", "第一时间联系", "马上安排"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["电话", "微信"] }
      ]
    },
    {
      "id": "faq_priority_timeline_natural_opening",
      "category": "faq",
      "tags": ["critical", "faq_priority", "timeline", "paraphrase"],
      "description": "用户在开场用自然话术问多久会联系我时，应先答疑，不得过早承诺联系或切联系方式。",
      "messages": [
        "你好",
        "你们多久会联系我呀"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["基本情况", "聊清楚", "推进", "后面"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["联系你", "牵线同事", "第一时间联系", "留电话", "留微信"] }
      ]
    },
    {
      "id": "faq_priority_timeline_mid_profile_resume_field",
      "category": "faq",
      "tags": ["critical", "faq_priority", "timeline", "resume_profile"],
      "description": "用户在资料收集中途问多久联系时，应先答疑，再回当前资料主线，而不是回开场或承诺马上联系。",
      "messages": [
        "我是男生，深圳，90后，本科，IT",
        "你们多久会联系我呀"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["基本情况", "聊清楚", "推进", "后面"] },
        { "type": "response_contains_any", "turn": 2, "values": ["单身", "婚况", "另一半", "看重", "收入"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["先简单介绍下自己", "联系你", "牵线同事", "留电话", "留微信"] }
      ]
    },
    {
      "id": "faq_priority_reliable",
      "category": "faq",
      "tags": ["critical", "faq_reliable"],
      "description": "用户问平台是否靠谱时，应先回答靠谱相关问题。",
      "messages": [
        "找对象",
        "你们平台靠谱吗"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["靠谱", "安全", "放心", "靠谱的"] }
      ]
    },
    {
      "id": "faq_priority_safety",
      "category": "faq",
      "tags": ["faq_safety"],
      "description": "用户问安全吗时，应先解释安全问题，不做资料收集。",
      "messages": [
        "找对象",
        "你们平台安全吗"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["安全", "放心", "可靠", "正规", "专业"] }
      ]
    },
    {
      "id": "faq_identity_are_you_ai",
      "category": "faq",
      "tags": ["critical", "faq_identity", "humanlike"],
      "description": "用户问“你是AI吗”时，不应暴露AI身份，应保持红娘人设并先答疑。",
      "messages": [
        "找对象",
        "你是AI吗"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["红娘", "同城脱单联盟", "牵线"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["AI", "人工智能", "大模型", "机器人", "ChatGPT", "GPT"] }
      ]
    },
    {
      "id": "faq_identity_are_you_robot",
      "category": "faq",
      "tags": ["critical", "faq_identity", "humanlike"],
      "description": "用户问“你是真人还是机器人”时，不应承认机器人身份，应回到红娘服务语境。",
      "messages": [
        "找对象",
        "你是真人还是机器人"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["红娘", "牵线", "同城"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["机器人", "AI", "人工智能", "大模型"] }
      ]
    },
    {
      "id": "faq_identity_followup_not_expose",
      "category": "faq",
      "tags": ["critical", "faq_identity", "followup"],
      "description": "用户连续追问身份来源时，连续两轮都不应暴露AI身份，也不应切回资料收集。",
      "messages": [
        "找对象",
        "你是AI吗",
        "说实话你是不是机器人"
      ],
      "assertions": [
        { "type": "response_not_contains_any", "turn": 2, "values": ["AI", "人工智能", "大模型", "机器人", "ChatGPT", "GPT"] },
        { "type": "response_not_contains_any", "turn": 3, "values": ["AI", "人工智能", "大模型", "机器人", "ChatGPT", "GPT"] },
        { "type": "response_not_contains_any", "turn": 3, "values": ["电话", "微信", "学历", "年龄"] }
      ]
    }
  ]
}
