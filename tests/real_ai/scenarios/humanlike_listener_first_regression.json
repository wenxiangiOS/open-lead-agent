{
  "scenarios": [
    {
      "id": "listener_first_greeting_probe_intent",
      "category": "humanlike_listener_first",
      "tags": ["critical", "humanlike", "listener_first", "greeting"],
      "description": "用户纯打招呼时，应先建立连接并轻问来意，不应直接切字段。",
      "messages": [
        "你好"
      ],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["找对象", "了解下", "聊聊", "情况"] },
        { "type": "final_response_not_contains_any", "values": ["你今年多大", "你在哪个城市", "你做什么工作", "你是什么学历"] }
      ]
    },
    {
      "id": "listener_first_zaima_probe_intent",
      "category": "humanlike_listener_first",
      "tags": ["critical", "humanlike", "listener_first", "greeting"],
      "description": "用户首轮问在吗时，应先连接并探测来意，不应直接采字段。",
      "messages": [
        "在吗"
      ],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["在呢", "在呀", "找对象", "了解下"] },
        { "type": "final_response_not_contains_any", "values": ["你今年多大", "你在哪个城市", "你是什么学历"] }
      ]
    },
    {
      "id": "listener_first_unstable_opening_clarify_probe_intent",
      "category": "humanlike_listener_first",
      "tags": ["critical", "humanlike", "listener_first", "opening_clarify"],
      "description": "用户首轮输入疑似乱码或无法稳定理解时，应先轻澄清并回到来意分流，不应直接切字段。",
      "messages": [
        "佃�好"
      ],
      "assertions": [
        { "type": "final_response_contains_any", "values": ["没看懂", "没太接住", "没看明白", "没反应过来"] },
        { "type": "final_response_contains_any", "values": ["找对象", "了解下", "看看情况", "问问情况"] },
        { "type": "final_response_not_contains_any", "values": ["男生还是女生", "你今年多大", "你在哪个城市", "你是什么学历"] }
      ]
    },
    {
      "id": "listener_first_opening_clarify_then_soft_intent_self_intro",
      "category": "humanlike_listener_first",
      "tags": ["critical", "humanlike", "listener_first", "opening_clarify", "open_self_intro"],
      "description": "开场轻澄清后，用户若回应“先了解下”这类软意图，下一轮应给开放自述入口，而不是直接切性别年龄。",
      "messages": [
        "佃�好",
        "先了解下"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 1, "values": ["没看懂", "没太接住", "没看明白", "没反应过来"] },
        { "type": "response_contains_any", "turn": 2, "values": ["介绍下自己", "简单说说自己", "顺着了解", "大概情况"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["男生还是女生", "你今年多大", "你在哪个城市"] }
      ]
    },
    {
      "id": "listener_first_opening_probe_particle_soft_intent_self_intro",
      "category": "humanlike_listener_first",
      "tags": ["critical", "humanlike", "listener_first", "opening_clarify", "open_self_intro"],
      "description": "开场探询后，用户回复“先了解下呢”这类带语气词的软意图，下一轮仍应给开放自述入口，不应直接切字段。",
      "messages": [
        "你好",
        "先了解下呢"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 1, "values": ["找对象", "了解下", "聊聊", "情况"] },
        { "type": "response_contains_any", "turn": 2, "values": ["介绍下自己", "简单说说自己", "顺着了解", "大概情况"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["男生还是女生", "你今年多大", "你在哪个城市"] }
      ]
    },
    {
      "id": "listener_first_opening_probe_xiankan_soft_intent_self_intro",
      "category": "humanlike_listener_first",
      "tags": ["critical", "humanlike", "listener_first", "opening_clarify", "open_self_intro"],
      "description": "开场探询后，用户回复“我先看看”这类观望表达，下一轮应先邀请用户简单介绍自己，而不是直接盘问资料。",
      "messages": [
        "你好",
        "我先看看"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 1, "values": ["找对象", "了解下", "聊聊", "情况"] },
        { "type": "response_contains_any", "turn": 2, "values": ["介绍下自己", "简单说说自己", "顺着了解", "大概情况"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["男生还是女生", "你今年多大", "你在哪个城市"] }
      ]
    },
    {
      "id": "listener_first_opening_probe_wenwen_qingkuang_prefix_self_intro",
      "category": "humanlike_listener_first",
      "tags": ["critical", "humanlike", "listener_first", "open_self_intro"],
      "description": "开场探询后，用户回复“就是想先问问情况呢”这类带前缀的低压了解表达，下一轮仍应给开放自述入口，而不是直接切字段。",
      "messages": [
        "你好",
        "就是想先问问情况呢"
      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 1, "values": ["找对象", "了解下", "问问情况", "聊聊"] },
        { "type": "response_contains_any", "turn": 2, "values": ["介绍下自己", "简单说说自己", "顺着了解", "大概情况"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["男生还是女生", "你今年多大", "你在哪个城市"] }
      ]
    },
    {
      "id": "listener_first_opening_faq_does_not_collect_fields",
      "category": "humanlike_listener_first",
      "tags": ["critical", "humanlike", "listener_first", "faq"],
      "description": "开场直接问收费时，应先答收费，不应同时切资料字段。",
      "messages": [
