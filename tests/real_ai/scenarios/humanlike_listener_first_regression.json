      ],
      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["可以", "不强求", "不留也行", "先聊"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["留个电话", "加个微信", "男生还是女生", "你今年多大"] }
