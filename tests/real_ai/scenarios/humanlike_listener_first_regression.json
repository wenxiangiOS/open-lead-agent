      "assertions": [
        { "type": "response_contains_any", "turn": 2, "values": ["收费", "免费", "服务", "安排"] },
        { "type": "response_not_contains_any", "turn": 2, "values": ["男生还是女生", "你今年多大", "你在哪个城市", "你是什么学历"] }
      ]
    },
    {
